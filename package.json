{
  "name": "business-analytics-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "e2e": "playwright test --project=desktop --project=touch && playwright test --project=perf --workers=1",
    "verify": "npm run typecheck && npm run test && npm run build && npm run e2e",
    "bas": "node scripts/bas.ts",
    "pack:schema": "node scripts/bas.ts schema",
    "integrations:check": "node scripts/bas.ts integrations check",
    "measure": "playwright test --project=measure --workers=1",
    "kpi1": "node scripts/kpi1.ts"
  },
  "dependencies": {
    "@fluentui/react-components": "^9.75.1",
    "@fluentui/react-icons": "^2.0.345",
    "@fluentui/react-motion": "^9.16.5",
    "d3": "^7.9.0",
    "d3-sankey": "^0.12.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0-alpha-2026-11-01",
    "@testing-library/react": "^16.3.3",
    "@types/d3": "^7.4.3",
    "@types/d3-sankey": "^0.12.5",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0-beta.1"
  }
}
